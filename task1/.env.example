# Optional. The code also accepts an auto-injected VERCEL_OIDC_TOKEN, which
# the AI SDK docs describe Vercel providing to every deployed project with no
# setup — but that didn't hold on this project (Hobby plan, file-upload
# deploy) when tested against the live URL, so set this explicitly (locally
# in .env.local, or as a Vercel project env var for the deployed app) to get
# LLM-written "why it matters" explanations. Without it the app runs in
# rules-only mode (deterministic keyword scoring, no LLM summaries) and still
# produces a complete digest — this is the designed fallback, not a bug.
AI_GATEWAY_API_KEY=

# Optional. If set, /api/cron requires this as a Bearer token. Vercel Cron
# sends it automatically when this is configured as a project env var.
CRON_SECRET=
